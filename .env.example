# Leave MONGODB_URI empty to boot an in-memory MongoDB automatically (dev only).
# For a real database use a MongoDB Atlas connection string:
#   MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/cargoflow?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/cargoflow
MONGODB_DB=cargoflow

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Notifications. Both default to `log`: messages are composed, stored and
# printed, but nothing leaves the building. Point them at real providers to send.
MAIL_TRANSPORT=log
MAIL_FROM=CargoFlow <no-reply@cargoflow.example>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

SMS_TRANSPORT=log
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+61400000000
